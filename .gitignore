# Xcode
build/
# QEchoIME 预编译 Rime 词典是随包分发的 vendor 数据，不是构建产物
!QEchoIME/RimeData/build/
!QEchoIME/RimeData/build/**
DerivedData/
.derivedData/
*.xcuserstate
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
# LLVM coverage 输出（xcodebuild 在仓库根扔出来的临时 profile 文件）
*.profraw

# CocoaPods
Pods/
!Podfile
!Podfile.lock

# Carthage
Carthage/Build/

# Swift Package Manager
.build/
.swiftpm/

# Third-party source code (use submodules or download scripts instead)
ThirdParty/libetpan/

# Build artifacts
*.a
!Libraries/libetpan/libetpan.a

# Backup files
*.backup

# Shell scripts (if not needed)
*.sh
!scripts/run_unit_tests.sh

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

